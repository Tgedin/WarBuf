# IBKR Web API Gateway (Docker)
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=your_account_id

# Email (Gmail SMTP with App Password)
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Dashboard URL — included in the weekly ping email
DASHBOARD_URL=https://your-domain.com

# GitHub Copilot — required for LLM analysis
# Use a FINE-GRAINED personal access token (not classic):
#   github.com/settings/tokens/new → Permissions → Other → Models → Read-only
# No repository access needed.
GITHUB_TOKEN=your_github_fine_grained_token

# Optional fallback LLM providers (only needed if not using Copilot)
# GROQ_API_KEY=your_groq_key
# ANTHROPIC_API_KEY=your_anthropic_key
# OPENAI_API_KEY=your_openai_key
